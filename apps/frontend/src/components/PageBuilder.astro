---
import RichTextBlock from '@/components/blocks/RichTextBlock.astro'
import HeroBlock from '@/components/blocks/HeroBlock.astro'
import ImageBlock from '@/components/blocks/ImageBlock.astro'

const { content = [] } = Astro.props
---

{
  content.map((block: any) => {
    switch (block._type) {
      case 'richTextBlock':
        return <RichTextBlock {...block} />

      case 'heroBlock':
        return <HeroBlock {...block} />

      case 'imageBlock':
        return <ImageBlock {...block} />

      default:
        return null
    }
  })
}
