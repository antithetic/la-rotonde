---
import PortableText from '@/components/sanity/PortableText.astro'
import { urlForImage } from '@/lib/sanity/image'

const {
  title,
  imageSplit = false,
  orientation = 'imageLeft',
  image,
  caption,
  captionAlignment = 'center',
  captionPosition = 'bottom',
} = Astro.props

const imageUrl = image
  ? urlForImage(image).width(1600).auto('format').url()
  : null

const alignmentClasses = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right',
}

const positionClasses = {
  top: 'items-start',
  middle: 'items-center',
  bottom: 'items-end',
}

const captionAlignmentClass =
  alignmentClasses[captionAlignment as keyof typeof alignmentClasses] ??
  alignmentClasses.center

const captionPositionClass =
  positionClasses[captionPosition as keyof typeof positionClasses] ??
  positionClasses.bottom

const isImageRight = orientation === 'imageRight'
---

<section class="image-block mb-48">
  {
    imageSplit ? (
      <div class:list={['grid gap-8 md:grid-cols-2']}>
        {isImageRight ? (
          <>
            {caption && (
              <div
                class:list={[
                  'flex',
                  captionPositionClass,
                  captionAlignmentClass,
                ]}
              >
                <div class="w-full">
                  <PortableText value={caption} />
                </div>
              </div>
            )}

            {imageUrl && (
              <figure>
                <img
                  src={imageUrl}
                  alt={image?.alt ?? ''}
                  class="h-auto w-full"
                  loading="lazy"
                />
              </figure>
            )}
          </>
        ) : (
          <>
            {imageUrl && (
              <figure>
                <img
                  src={imageUrl}
                  alt={image?.alt ?? ''}
                  class="h-auto w-full"
                  loading="lazy"
                />
              </figure>
            )}

            {caption && (
              <div
                class:list={[
                  'flex',
                  captionPositionClass,
                  captionAlignmentClass,
                ]}
              >
                <div class="w-full text-4xl">
                  <PortableText value={caption} />
                </div>
              </div>
            )}
          </>
        )}
      </div>
    ) : (
      imageUrl && (
        <figure>
          <img
            src={imageUrl}
            alt={image?.alt ?? ''}
            class="h-auto w-full"
            loading="lazy"
          />

          {caption && (
            <figcaption class:list={['mt-3', captionAlignmentClass]}>
              <PortableText value={caption} />
            </figcaption>
          )}
        </figure>
      )
    )
  }
</section>
