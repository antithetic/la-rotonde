---
import PortableText from '@/components/sanity/PortableText.astro'

const { title, showTitle, content } = Astro.props
---

<!-- RichTextBlock.astro -->
<section class="rich-text-block mb-48 mx-auto max-w-[65ch]">
  {
    showTitle && (
      <header class="mb-6">
        <h2 class="text-3xl font-bold">{title}</h2>
      </header>
    )
  }

  <div class="rich-text-block__content">
    <PortableText value={content} />
  </div>
</section>
