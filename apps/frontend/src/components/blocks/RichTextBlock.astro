---
import PortableText from '@/components/sanity/PortableText.astro'

const { title, content } = Astro.props
---

<!-- RichTextBlock.astro -->
<section class="rich-text-block">
  <header>
    <h2>{title}</h2>
  </header>

  <div class="rich-text-block__content">
    <PortableText value={content} />
  </div>
</section>
