---
import Layout from '../layouts/Layout.astro'
import { loadQuery } from '@/lib/sanity/load-query'
import { SITE_SETTINGS_QUERY } from '@/lib/sanity/queries'

// fetch site settings from sanity
const { data: settings } = await loadQuery<{
  siteTitle: string | null
  tagline: string | null
  copyrightText: string | null
} | null>({ query: SITE_SETTINGS_QUERY })

console.log('settings', settings)
---

<Layout>
  <div class="flex flex-col h-screen max-w-3xl mx-auto">
    <header>
      <h1 class="text-5xl font-bold underline">{settings?.siteTitle}</h1>
      <p class="text-sm italic">{settings?.tagline}</p>
    </header>

    <main class="flex-1 p-4">
      Main content, Sanity Page Builder will be rendered here
    </main>

    <footer class="mb-16">
      <span class="text-sm italic block text-center">
        &copy; <time data-current-year> </time> &nbsp; {settings?.copyrightText}
      </span>
    </footer>
  </div>

  <script>
    import { printCurrentYear } from '@/lib/automatic-year'

    printCurrentYear()
  </script>
</Layout>
