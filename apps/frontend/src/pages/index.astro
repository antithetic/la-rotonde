---
import Layout from '../layouts/Layout.astro'
// TODO: Use for rendering homePage content

import PageBuilder from '@/components/PageBuilder.astro'
import { loadQuery } from '@/lib/sanity/load-query'
import { SITE_SETTINGS_QUERY, HOME_PAGE_QUERY } from '@/lib/sanity/queries'

// fetch site settings from sanity
const { data: settings } = await loadQuery<{
  siteTitle: string | null
  tagline: string | null
  copyrightText: string | null
} | null>({ query: SITE_SETTINGS_QUERY })

const { data: homePage } = await loadQuery<{
  content: any[]
} | null>({ query: HOME_PAGE_QUERY })

console.log('settings', settings)
console.log('homePage', homePage)
---

<Layout>
  <div class="flex flex-col h-screen max-w-3xl mx-auto mb-48">
    <header class="mb-16">
      <h1 class="text-5xl font-bold underline mb-4">{settings?.siteTitle}</h1>
      <p class="text-sm italic">{settings?.tagline}</p>
    </header>

    <main class="flex-1 p-4">
      {homePage?.content && <PageBuilder content={homePage.content} />}
    </main>

    <footer>
      <span class="text-sm italic block text-center mb-48">
        &copy; <time data-current-year> </time> &nbsp; {settings?.copyrightText}
      </span>
    </footer>
  </div>

  <script>
    import { printCurrentYear } from '@/lib/automatic-year'

    printCurrentYear()
  </script>
</Layout>
