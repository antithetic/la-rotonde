---
import Layout from '../layouts/Layout.astro'
import { loadQuery } from '@/lib/sanity/load-query'
import { SITE_SETTINGS_QUERY } from '@/lib/sanity/queries'

// fetch site settings from sanity
const { data: settings } = await loadQuery<{
  siteTitle: string | null
  tagline: string | null
  copyrightText: string | null
} | null>({ query: SITE_SETTINGS_QUERY })

console.log('settings', settings)
---

<Layout>
  <div class="max-w-3xl mx-auto flex flex-col">
    <header>
      <!-- updaste to pull from sanity -->
      <h1 class="text-3xl font-bold underline">
        {settings?.siteTitle}
      </h1>
      <p class="text-lg italic">{settings?.tagline}</p>
    </header>
    <main>
      <!-- sanity content goes here -->
    </main>
    <footer>
      <!-- updaste to pull from sanity -->
      <p>
        &copy; <time data-current-year> </time> &nbsp;
        {settings?.copyrightText}
      </p>
    </footer>
  </div>

  <script>
    import { printCurrentYear } from '@/lib/automatic-year'

    printCurrentYear()
  </script>
</Layout>
