{
  "name": "la-rotonde",
  "private": true,
  "description": "Website for La Rotonde--HiFi music and social club",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:studio": "turbo run dev --filter=studio",
    "dev:web": "turbo run dev --filter=frontend",
    "format": "prettier --write .",
    "lint": "oxlint --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.3.4",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.10.12"
  }
}
